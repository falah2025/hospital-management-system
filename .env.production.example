# Production Environment Configuration
# Copy this to backend/.env and fill in your values

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/hms_db?schema=public"

# JWT (Generate a strong random string)
JWT_SECRET="change-this-to-a-64-character-random-string"
JWT_EXPIRES_IN="7d"

# Server
PORT=5000
NODE_ENV=production

# Frontend URL
FRONTEND_URL="https://your-domain.com"

# Encryption
ENCRYPTION_KEY="your-32-character-encryption-key"

# Optional: Firebase for Push Notifications
FIREBASE_SERVER_KEY="your-firebase-server-key"
